# ==============================================================================
# ApleShahar Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Allowed CORS origins (e.g. your CloudFront domain, EC2 IP, or localhost)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Amazon RDS PostgreSQL)
# ------------------------------------------------------------------------------
# Either provide a full DATABASE_URL or individual DB_* parameters:
# DATABASE_URL=postgresql://postgres:your_password@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/apleshahar

DB_HOST=localhost
DB_PORT=5432
DB_NAME=apleshahar
DB_USER=postgres
DB_PASSWORD=postgres
# Set to 'true' when connecting to Amazon RDS PostgreSQL
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=replace-with-a-secure-random-secret-key-32-chars-minimum
JWT_EXPIRES_IN=7d
AUTHORITY_SECURITY_CODE=AUTHORITY

# ------------------------------------------------------------------------------
# 3. AWS CLOUD SERVICES (Optional in dev, activated automatically in AWS)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1

# Amazon S3 Media Storage (Bucket name created in S3)
# When running on EC2, IAM Instance Profile provides credentials automatically!
S3_BUCKET_NAME=apleshahar-media-storage

# Amazon CloudFront (Optional CDN distribution domain for caching images)
# CLOUDFRONT_DOMAIN=d123456abcdef.cloudfront.net

# Amazon SNS (Simple Notification Service)
# Topic ARN for disptaching email/SMS notifications to ward officers
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:apleshahar-alerts
